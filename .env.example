# --- Database ---
# Local dev: matches docker-compose.yml
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_answering?schema=public"

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# --- Twilio (Phase 4 — not used yet) ---
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_AI_ASSISTANT_ID=""

# --- Google Calendar OAuth (Phase 3 — not used yet) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/google/callback"

# --- Encryption key for per-tenant secrets (Phase 3) ---
# 32-byte key, base64 encoded. Generate with: openssl rand -base64 32
TENANT_SECRETS_KEY=""

# --- Stripe (Phase 7 — not used yet) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
