# --- Server ---
PORT=4000
# Public hostname (no scheme) used to build the wss:// URL we advertise to
# Twilio in the TwiML. In dev: your ngrok host (e.g. abc123.ngrok-free.app).
# In prod: your Railway service hostname.
PUBLIC_HOST=""

# --- Database (same Postgres as the dashboard) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_answering?schema=public"

# --- Anthropic ---
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"

# --- Twilio ---
# Used to validate X-Twilio-Signature on inbound HTTP webhooks.
TWILIO_AUTH_TOKEN=""

# --- Optional: skip signature validation in local dev ---
SKIP_TWILIO_SIGNATURE_CHECK="false"
